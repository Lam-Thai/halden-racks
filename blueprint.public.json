{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Halden prototype",
		"author": "Lam Thai",
		"description": "A live WordPress in your browser with the Halden theme and demo content. Changes are private to your browser tab and reset when it closes."
	},
	"landingPage": "/",
	"login": true,
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"HALDEN_DEMO": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Lam-Thai/halden-racks",
				"ref": "main",
				"path": "theme/halden"
			},
			"options": {
				"activate": true,
				"targetFolderName": "halden"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; halden_seed_run();"
		}
	]
}
